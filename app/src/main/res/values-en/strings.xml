    <string name="permission_setup_title">Set up permissions</string>
    <string name="permission_setup_subtitle">BrainXP needs a few system permissions before it can guard your playtime. Work through each step in order.</string>
    <string name="permission_setup_step_label">Step %1$d of %2$d</string>
    <string name="permission_setup_open">Open settings</string>
    <string name="permission_setup_granted">Already on</string>
    <string name="permission_setup_optional">Optional</string>
    <string name="permission_setup_recommended">Recommended</string>
    <string name="permission_setup_continue">Continue</string>
    <string name="permission_setup_finish">Done</string>
    <string name="permission_setup_blocked">The two required permissions above must be on before you can continue.</string>
    <string name="permission_setup_degraded">Protection is on, but not fully. The steps you skipped make it easier for BrainXP to fail without telling you.</string>
    <string name="permission_setup_unavailable">This device has no settings page for that permission.</string>

    <string name="permission_notifications_title">Notifications</string>
    <string name="permission_notifications_breaks">Without this you will not be told when playtime is nearly up, and the guard service notification stays hidden.</string>

    <string name="permission_usage_access_title">Usage access</string>
    <string name="permission_usage_access_breaks">Without this BrainXP cannot tell which app you have open, so nothing can be restricted at all.</string>

    <string name="permission_overlay_title">Display over other apps</string>
    <string name="permission_overlay_breaks">Without this the block screen cannot appear, so restricted apps stay wide open.</string>

    <string name="permission_battery_title">Exempt from battery saver</string>
    <string name="permission_battery_breaks">Without this the system can kill the guard service while the phone is idle, and restrictions stop with no warning.</string>

    <string name="permission_accessibility_title">Accessibility service</string>
    <string name="permission_accessibility_breaks">This is a slightly faster alternative app detector. Skipping it costs you nothing — the main detector is enough.</string>

    <string name="accessibility_service_label">BrainXP app detector</string>
    <string name="accessibility_service_description">Tells BrainXP which app you have just opened, so the apps you restrict can be locked sooner. BrainXP only reads the app name, never what is on your screen.</string>

